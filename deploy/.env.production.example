OPENAI_API_KEY=replace_on_server
JEONSE_LLM=api
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
# Maps/Directions 키와 별도. NAVER API HUB Application에서 발급하며
# 뉴스 검색과 지역 장소검색에 함께 사용한다.
NAVER_API_HUB_CLIENT_ID=optional_api_hub_client_id
NAVER_API_HUB_CLIENT_SECRET=optional_api_hub_client_secret
