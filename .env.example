# 필수: 실제 LLM을 사용할 때만 값을 입력한다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JEONSE_LLM=mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_ALLOW_INIT_FALLBACK=0

# NAVER Dynamic Map, Directions 5, Geocoding
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# NAVER 뉴스 및 지역 장소검색
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# TMAP 대중교통
TMAP_APP_KEY=

# 공공데이터 및 시장 데이터
MOLIT_RTMS_SERVICE_KEY=
MOLIT_SERVICE_KEY=
SAFEMAP_SERVICE_KEY=
RONE_API_KEY=
EV_CHARGER_SERVICE_KEY=

# 선택 연동
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_DATASET_ID=
KAKAO_REST_API_KEY=
CODEF_SERVICE_TYPE=sandbox
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# 검색당 실제 경로 API 호출 상한
ROUTE_API_EXACT_CANDIDATE_LIMIT=5
ROUTE_API_MAX_WORKERS=3
JEONSE_SHOW_RAG_TRACE=1
