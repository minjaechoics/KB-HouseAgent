.env
.env.*
!.env.example
!.env.production.example
deploy/.htpasswd
deploy/PRIVATE_ACCESS.txt

# 사용자가 전달한 원본 부동산 PDF 묶음(라이선스/개인정보 확인 전 Git 제외)
0_*pdf_*/
deploy/*.private.env
envshare/
*.pem
*.key
*.p12
*.pfx
__pycache__/
*.py[cod]
.pytest*/
.test_tmp/
.verify*/
.coverage
htmlcov/
.venv/
venv/

# 운영/생성 데이터는 GitHub 용량 제한과 원천데이터 이용조건 때문에 제외한다.
data/generated/**
!data/generated/.gitkeep
!data/generated/README.md
data/downloaded/**
!data/downloaded/.gitkeep
!data/downloaded/README.md
*.db
*.sqlite
*.sqlite3

# 배포 산출물과 로컬 QA 캡처
deploy/*.tar.gz
deploy/*.tgz
deploy/qa-*.png
deploy/PRIVATE_ACCESS.txt

# 콘솔 비교 실험의 질의별 원시 출력(실행할 때마다 새로 생성)
reports/experiments/*.json
